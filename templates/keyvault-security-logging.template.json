{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "keyVaults": {
      "type": "string",
      "defaultValue": "none",
      "metadata": {
        "description": "Comma separated list of vaults to add the security workspace diagnostic setting to, each entry in the form resourceGroupName/keyVaultName. 'none' deploys no diagnostic settings."
      }
    },
    "securityLogAnalyticsWorkspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource id of the security Log Analytics workspace the audit logs are sent to."
      }
    },
    "diagnosticSettingName": {
      "type": "string",
      "defaultValue": "security-la",
      "metadata": {
        "description": "Name of the diagnostic setting added to each vault. A new name leaves the existing settings on the vault untouched."
      }
    }
  },
  "variables": {
    "deploymentUrlBase": "https://raw.githubusercontent.com/SkillsFundingAgency/das-platform-building-blocks/master/templates/",
    "keyVaultList": "[if(equals(parameters('keyVaults'), 'none'), createArray(), split(replace(parameters('keyVaults'), ' ', ''), ','))]"
  },
  "resources": [
    {
      "apiVersion": "2022-09-01",
      "name": "[concat('key-vault-security-logging-', split(variables('keyVaultList')[copyIndex()], '/')[1])]",
      "type": "Microsoft.Resources/deployments",
      "resourceGroup": "[split(variables('keyVaultList')[copyIndex()], '/')[0]]",
      "copy": {
        "name": "keyVaultSecurityDiagnosticSettingCopy",
        "count": "[length(variables('keyVaultList'))]"
      },
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[uri(variables('deploymentUrlBase'),'diagnostic-settings.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "resourceType": {
            "value": "Microsoft.KeyVault/vaults"
          },
          "resourceName": {
            "value": "[split(variables('keyVaultList')[copyIndex()], '/')[1]]"
          },
          "diagnosticSettingName": {
            "value": "[parameters('diagnosticSettingName')]"
          },
          "logAnalyticsWorkspaceResourceId": {
            "value": "[parameters('securityLogAnalyticsWorkspaceResourceId')]"
          },
          "logAnalyticsDestinationType": {
            "value": "Dedicated"
          },
          "logCategoryGroups": {
            "value": [
              "audit"
            ]
          },
          "logCategories": {
            "value": []
          },
          "metricCategories": {
            "value": []
          }
        }
      }
    }
  ],
  "outputs": {}
}
